{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Airnobe",
  "version": "0.1.0",
  "identifier": "com.airnobe.reader",
  "build": {
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build:guide && npm --prefix ../.. run build && npm run build:sidecar:binary",
    "frontendDist": "../../reader-web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Airnobe",
        "width": 1280,
        "height": 800,
        "minWidth": 600,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "externalBin": ["binaries/airnobe-sidecar"],
    "resources": ["resources/kuromoji-dict", "resources/airnobe-getting-started.epub"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
