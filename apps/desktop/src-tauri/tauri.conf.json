{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Airnobe",
  "version": "0.1.0",
  "identifier": "com.airnobe.reader",
  "build": {
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm --prefix ../.. run build",
    "frontendDist": "../../reader-web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Airnobe",
        "width": 1280,
        "height": 800,
        "minWidth": 600,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
