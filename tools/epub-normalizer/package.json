  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "convert": "tsx src/cli.ts"
  },
  "dependencies": {
    "@airnobe/book-format": "0.1.0",
    "@xmldom/xmldom": "^0.8.11",
    "jszip": "^3.10.1"
  }
}
